# =============================================================================
# insta-knowledge-base — central configuration (.env)
# Copy to .env and adjust. All paths may be relative to the repo root or absolute.
# Every script + the Docker stack read this file (see scripts/config.sh).
# =============================================================================

APP_ENV=development
LOG_LEVEL=DEBUG

# Project root (absolute) — used by docker compose for the /workspace mount.
PROJECT_ROOT=/path/to/kb_insta

# -----------------------------------------------------------------------------
# REMOTE MCP (VPS / HTTPS access)
# -----------------------------------------------------------------------------
# Transport the MCP server listens on (the `mcp` compose service sets
# streamable-http and serves MCP_PORT on the host; .mcp.json points there).
#   stdio | http | streamable-http | sse
# Running src/mcp_server/server.py directly with streamable-http inherited
# starts an HTTP server, so an stdio client waits for a peer that never
# speaks and reports only "Connection closed" -- with no hint as to why.
# Force stdio when driving the server over a pipe:
#   MCP_TRANSPORT=stdio uv run python src/mcp_server/server.py
MCP_TRANSPORT=streamable-http
# Bind interface + port for the HTTP MCP server (inside the container).
MCP_HOST=0.0.0.0
MCP_PORT=8849

# -----------------------------------------------------------------------------
# INSTA KNOWLEDGE BASE (Postgres + pgvector, local LLM, optional Obsidian export)
# -----------------------------------------------------------------------------
POSTGRES_USER=kb
POSTGRES_PASSWORD=kb
POSTGRES_DB=knowledge
POSTGRES_PORT=5433
POSTGRES_CONTAINER=insta-kb-postgres
# Postgres runs as THIS uid/gid instead of the image's postgres user (999).
# POSTGRES_DATA_DIR lives inside the project tree, so a `chown -R $USER` on
# the repo root -- an entirely reasonable thing to do -- used to take the data
# dir away from uid 999 and the database came up looping
# `could not open file "global/pg_filenode.map": Permission denied`.
# Matching the uid makes the "wrong" owner the right one. Use `id -u` / `id -g`.
PG_UID=1000
PG_GID=1000
POSTGRES_DATA_DIR=${PROJECT_ROOT}/.pgdata
# SQLAlchemy connection string (psycopg3 driver). Must match the vars above.
DATABASE_URL=postgresql+psycopg://kb:kb@127.0.0.1:5433/knowledge

# -----------------------------------------------------------------------------
# INSTAGRAM SAVED -> KNOWLEDGE BASE (RabbitMQ + ig-worker daemon)
# -----------------------------------------------------------------------------
# sessionid from the Chrome cookies (Instagram, logged-in). Never a password.
# Chrome 127+ encrypts the sessionid (app-bound), so it must be copied from
# DevTools -> Application -> Cookies -> instagram.com -> sessionid -> Value.
IG_SESSIONID=
# Netscape cookies.txt exported from the logged-in browser. Optional: the worker
# downloads via the authenticated instagrapi client (IG_SESSIONID) first, so
# private posts work without it. Only the yt-dlp fallback path uses it.
IG_COOKIES_FILE=
# RabbitMQ: default local docker service; VPS = point at your RabbitMQ.
RABBITMQ_URL=amqp://guest:guest@localhost:5673/
RABBITMQ_DATA_DIR=../.rabbitmq
RABBITMQ_PORT=5673
RABBITMQ_MANAGEMENT_PORT=15673
# The ig-worker daemon can run either on the HOST (uv) or containerized
# (docker compose -f .devcontainer/docker-compose.yml up -d worker, Task 4,
# 2026-10-07) -- the earlier note that containers couldn't reach Ollama/
# Postgres was stale; host.docker.internal + host-gateway reaches both fine.
# Host path, if you want it:
#   uv run python -m workers.ig_worker
RABBITMQ_QUEUE=ig.saved
IG_WORKER_CONCURRENCY=1
IG_DOWNLOADS_DIR=downloads/ig
IG_DELETE_AFTER_INGEST=true
IG_STATE_FILE=downloads/ig/state.json
# Segundos mínimos entre mensagens. 0 = sem pausa, consome o mais rápido possível.
# O limite deste pipeline é o Instagram, não a GPU: duas varreduras completas numa
# hora já geraram 429 e derrubaram coleções da listagem. Para uma corrida longa
# (os 2145 posts salvos), 90 dá ~40 posts/hora e roda desatendido.
# Contado do INÍCIO de cada mensagem, então é um teto de velocidade: um post que
# demore mais que o intervalo não dorme nada.
IG_WORKER_MIN_INTERVAL=0
# Local vision model for describing saved photos (Ollama).
OLLAMA_VISION_MODEL=qwen2.5vl:7b
